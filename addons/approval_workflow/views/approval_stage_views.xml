<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_approval_stage_list" model="ir.ui.view">
        <field name="name">approval.stage.list</field>
        <field name="model">approval.stage</field>
        <field name="arch" type="xml">

            <list string="Étapes d'approbation">

                <field name="sequence"/>
                <field name="name"/>
                <field name="workflow_id"/>
                <field name="approver_type"/>
                <field name="approver_user_id"/>
                <field name="approver_group_id"/>
                <field name="min_approvals"/>
                <field name="is_blocking"/>
                <field name="active"/>

            </list>

        </field>
    </record>


    <record id="view_approval_stage_form" model="ir.ui.view">
        <field name="name">approval.stage.form</field>
        <field name="model">approval.stage</field>
        <field name="arch" type="xml">

            <form string="Étape d'approbation">

                <sheet>

                    <group>

                        <group>

                            <field name="name"/>
                            <field name="workflow_id"/>
                            <field name="sequence"/>

                        </group>

                        <group>

                            <field name="approver_type"/>
                            <field name="approver_user_id"
                                   invisible="approver_type != 'user'"/>

                            <field name="approver_group_id"
                                   invisible="approver_type != 'group'"/>

                            <field name="min_approvals"/>
                            <field name="is_blocking"/>
                            <field name="active"/>

                        </group>

                    </group>

                </sheet>

            </form>

        </field>
    </record>

</odoo>