<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_purchase_order_form_inherit_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">

                <button
                    name="action_submit_for_approval"
                    type="object"
                    string="Soumettre pour approbation"
                    class="btn-primary"
                    invisible="state not in ('draft', 'sent') or approval_state in ('draft', 'in_progress')"/>

                <button
                    name="action_view_approval_request"
                    type="object"
                    string="Voir la demande d'approbation"
                    class="btn-secondary"
                    invisible="not approval_request_id"/>

            </xpath>

        </field>
    </record>

</odoo>